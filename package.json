{
  "name": "vibecollab",
  "version": "0.5.0",
  "description": "File-only context synchronization for human and AI coding teams through Git pull requests.",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/redmaplewww/vibecollab#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/redmaplewww/vibecollab.git"
  },
  "keywords": [
    "ai-coding",
    "collaboration",
    "git",
    "pull-request",
    "vibe-coding"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vibecollab": "scripts/cli.mjs"
  },
  "files": [
    "scripts/",
    "skills/",
    "templates/",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "init": "node scripts/install.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "verify": "node --test && node scripts/check-distribution.mjs",
    "pta": "node .project-to-act/bin/pta.mjs --project-root ."
  }
}
